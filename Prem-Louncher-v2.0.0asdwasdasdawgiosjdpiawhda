-- ================================================
-- THEME HELPERS
-- ================================================
local function TW(obj, props, t, style, dir)
    TweenService:Create(obj,
        TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props):Play()
end
local function MkCorner(r, p)
    Instance.new("UICorner", p).CornerRadius = UDim.new(0, r or 8)
end
local function MkStroke(col, thick, parent)
    local s = Instance.new("UIStroke", parent)
    s.Color = col or THEME.violet; s.Thickness = thick or 1; return s
end
local function MkGrad(parent, c1, c2, rot)
    local g = Instance.new("UIGradient", parent)
    g.Color = ColorSequence.new(c1, c2); g.Rotation = rot or 0; return g
end
local function MkFrame(parent, size, pos, color, alpha)
    local f = Instance.new("Frame", parent)
    f.Size = size; f.Position = pos or UDim2.new(0,0,0,0)
    f.BackgroundColor3 = color or THEME.bg2
    f.BackgroundTransparency = alpha or 0
    f.BorderSizePixel = 0; return f
end
local function MkLabel(parent, text, size, pos, color, fs, bold, xa)
    local l = Instance.new("TextLabel", parent)
    l.Size = size; l.Position = pos or UDim2.new(0,0,0,0)
    l.BackgroundTransparency = 1; l.Text = text
    l.TextColor3 = color or THEME.text; l.TextSize = fs or 12
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.TextXAlignment = xa or Enum.TextXAlignment.Left
    l.BorderSizePixel = 0; return l
end
local function MkBtn(parent, text, size, pos, color, fs)
    local b = Instance.new("TextButton", parent)
    b.Size = size; b.Position = pos or UDim2.new(0,0,0,0)
    b.BackgroundColor3 = color or THEME.violet
    b.TextColor3 = THEME.white; b.TextSize = fs or 12
    b.Font = Enum.Font.GothamBold; b.BorderSizePixel = 0
    b.AutoButtonColor = false; b.Text = text
    MkCorner(8, b)
    b.MouseEnter:Connect(function() TW(b, {BackgroundColor3 = color:Lerp(THEME.white, 0.15)}, 0.12) end)
    b.MouseLeave:Connect(function() TW(b, {BackgroundColor3 = color}, 0.12) end)
    return b
end
local function MkToggleBtn(parent, text, size, pos, color, fs)
    local b = Instance.new("TextButton", parent)
    b.Size = size; b.Position = pos or UDim2.new(0,0,0,0)
    b.BackgroundColor3 = color or THEME.violet
    b.TextColor3 = THEME.white; b.TextSize = fs or 12
    b.Font = Enum.Font.GothamBold; b.BorderSizePixel = 0
    b.AutoButtonColor = false; b.Text = text
    MkCorner(8, b)
    b.MouseButton1Down:Connect(function() b.BackgroundTransparency = 0.3 end)
    b.MouseButton1Up:Connect(function()   b.BackgroundTransparency = 0   end)
    return b
end
local function MkOrbBg(parent)
    local defs = {
        {Color3.fromRGB(140,20,255),0.15,0.20,28},
        {Color3.fromRGB(200,20,240),0.78,0.15,22},
        {Color3.fromRGB(100,10,190),0.88,0.72,32},
        {Color3.fromRGB(180,50,255),0.10,0.80,20},
        {Color3.fromRGB(220,40,200),0.50,0.50,18},
    }
    local orbData = {}
    for i, def in ipairs(defs) do
        local sz  = def[4]
        local orb = MkFrame(parent, UDim2.new(0,sz,0,sz), UDim2.new(def[2],0,def[3],0), def[1], 0.74)
        orb.AnchorPoint = Vector2.new(0.5,0.5); MkCorner(sz/2, orb)
        orbData[i] = {
            orb=orb,bx=def[2],by=def[3],
            px=math.random(0,628)/100,py=math.random(0,628)/100,
            spd=math.random(5,9)/10,ax=math.random(3,6)/100,ay=math.random(3,6)/100
        }
    end
    local t = 0
    task.spawn(function()
        while parent and parent.Parent do
            t = t + 0.016
            for _, d in ipairs(orbData) do
                if d.orb and d.orb.Parent then
                    d.orb.Position = UDim2.new(
                        d.bx + math.sin(t*d.spd+d.px)*d.ax, 0,
                        d.by + math.cos(t*d.spd+d.py)*d.ay, 0)
                    d.orb.BackgroundTransparency = 0.70 + math.sin(t*d.spd*1.2+d.px)*0.12
                end
            end
            task.wait(0.03)
        end
    end)
end
local function MkScanline(parent)
    local sl = MkFrame(parent, UDim2.new(1,0,0,1), UDim2.new(0,0,0,0), THEME.magenta, 0.55)
    sl.ZIndex = 9
    local g = Instance.new("UIGradient", sl)
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(0,0,0)),
        ColorSequenceKeypoint.new(0.5, THEME.magenta),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(0,0,0)),
    })
    task.spawn(function()
        while parent and parent.Parent do
            TW(sl, {Position=UDim2.new(0,0,1,0), BackgroundTransparency=0.85}, 2.8, Enum.EasingStyle.Linear)
