local function MkToast(guiParent, msg, isErr)
    local col = isErr and Color3.fromRGB(140,28,55) or Color3.fromRGB(20,110,62)
    local n = MkFrame(guiParent, UDim2.new(0,340,0,40), UDim2.new(0.5,-170,0,-56), col)
    n.ZIndex = 99; MkCorner(10, n); MkStroke(isErr and THEME.red or THEME.green, 1, n)
    local shimmer = MkFrame(n, UDim2.new(1,0,0.45,0), UDim2.new(0,0,0,0), THEME.white, 0.91)
    MkCorner(10, shimmer)
    local icon = isErr and "⚠  " or "✓  "
    local lbl = MkLabel(n, icon..msg, UDim2.new(1,-14,1,0), UDim2.new(0,8,0,0), THEME.white, 12, true)
    lbl.ZIndex = 100
    TweenService:Create(n, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position=UDim2.new(0.5,-170,0,8)}):Play()
    task.delay(2.8, function()
        if not n or not n.Parent then return end
        TweenService:Create(n, TweenInfo.new(0.2), {Position=UDim2.new(0.5,-170,0,-56)}):Play()
        task.wait(0.25); if n and n.Parent then n:Destroy() end
    end)
end

