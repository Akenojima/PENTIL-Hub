    task.spawn(function()
        while parent and parent.Parent do
            t = t + 0.016
            for _,d in ipairs(orbData) do
                if d.orb and d.orb.Parent then
                    d.orb.Position = UDim2.new(d.bx+math.sin(t*d.spd+d.px)*d.ax,0,d.by+math.cos(t*d.spd+d.py)*d.ay,0)
