    end
    MkLabel(bar, title,    UDim2.new(1,-100,0,18), UDim2.new(0,62,0,iconTag and 26 or 8),  THEME.text, 12, true)
    if subtitle then
        MkLabel(bar, subtitle, UDim2.new(1,-100,0,14), UDim2.new(0,62,0, iconTag and 44 or 28), THEME.dim,  9, false)
    end
    local pStroke = MkStroke(THEME.violet, 1.2, parent)
    task.spawn(function()
        while parent and parent.Parent do
            TW(pStroke,{Color=THEME.magenta},1.6,Enum.EasingStyle.Sine); task.wait(1.7)
            if not parent or not parent.Parent then break end
            TW(pStroke,{Color=THEME.violet},1.6,Enum.EasingStyle.Sine); task.wait(1.7)
        end
    end)
    return bar, pStroke
end

local function MkScanline(parent)
    local sl = MkFrame(parent, UDim2.new(1,0,0,1), UDim2.new(0,0,0,0), THEME.magenta, 0.55)
    sl.ZIndex = 9
    local g = Instance.new("UIGradient", sl)
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),
        ColorSequenceKeypoint.new(0.5, THEME.magenta),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0)),
    })
