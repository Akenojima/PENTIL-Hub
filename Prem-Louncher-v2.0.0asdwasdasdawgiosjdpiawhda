-- step row (ganti makeStepRow lama → pakai tema launcher)
local function makeStepRow(parent, yPos, labelText, getter, setter, step, fmt, onChanged)
    -- label
    local lbl = MkLabel(parent, labelText,
        UDim2.new(0.38,0,0,28), UDim2.new(0.04,0,0,yPos),
        THEME.dim, 11, true)
    lbl.TextXAlignment = Enum.TextXAlignment.Left

