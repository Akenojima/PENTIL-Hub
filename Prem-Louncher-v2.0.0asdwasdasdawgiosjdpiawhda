    TW(btnRight,    {BackgroundColor3 = rightEnabled    and THEME.green or THEME.red}, 0.15)
    btnLeft2.Text = leftEnabled and "KIRI: ON" or "KIRI: OFF"
    TW(btnLeft2,    {BackgroundColor3 = leftEnabled     and THEME.green or THEME.red}, 0.15)
    btnHeadless.Text = headlessEnabled and "HEADLESS: ON" or "HEADLESS: OFF"
    TW(btnHeadless,  {BackgroundColor3 = headlessEnabled and THEME.green or THEME.red}, 0.15)
    btnVisualAll.Text = visualAllEnabled and "VISUAL ALL: ON" or "VISUAL ALL: OFF"
    TW(btnVisualAll,  {BackgroundColor3 = visualAllEnabled and THEME.green or THEME.red}, 0.15)
    applyKorbloxToTarget(player.Character)
    if visualAllEnabled then applyToEveryone() end
    MkToast(screenGui, "Semua config di-reset!")
end)

