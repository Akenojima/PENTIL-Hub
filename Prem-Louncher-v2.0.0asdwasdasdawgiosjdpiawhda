local function MkOrbBg(parent)
    local defs = {
        {Color3.fromRGB(140,20,255),0.15,0.20,28},
        {Color3.fromRGB(200,20,240),0.78,0.15,22},
        {Color3.fromRGB(100,10,190),0.88,0.72,32},
        {Color3.fromRGB(180,50,255),0.10,0.80,20},
        {Color3.fromRGB(220,40,200),0.50,0.50,18},
    }
    local orbData = {}
    for i, def in ipairs(defs) do
        local sz = def[4]
        local orb = MkFrame(parent, UDim2.new(0,sz,0,sz), UDim2.new(def[2],0,def[3],0), def[1], 0.74)
        orb.AnchorPoint = Vector2.new(0.5,0.5); MkCorner(sz/2, orb)
        orbData[i] = {orb=orb,bx=def[2],by=def[3],px=math.random(0,628)/100,py=math.random(0,628)/100,spd=math.random(5,9)/10,ax=math.random(3,6)/100,ay=math.random(3,6)/100}
    end
