-- apply saat pertama load — pakai task.spawn supaya tidak blocking
-- dan WaitForChild supaya tunggu karakter benar-benar siap
task.spawn(function()
    local char = player.Character or player.CharacterAdded:Wait()
    -- tunggu HumanoidRootPart sebagai sinyal karakter sudah fully loaded
    char:WaitForChild("HumanoidRootPart", 10)
    char:WaitForChild("Humanoid", 10)
    task.wait(0.3)  -- sedikit buffer tambahan
    applyKorbloxToTarget(char)
    if headlessEnabled then applyHeadless(char) end
end)

player.CharacterAdded:Connect(function(c)
    -- hapus semua sisa korblox dari karakter sebelumnya (jaga-jaga)
    for _, name in pairs({"KorbloxRightLeg","KorbloxLeftLeg","KorbloxRightLegR6","KorbloxLeftLegR6"}) do
        local old = c:FindFirstChild(name); if old then old:Destroy() end
    end
    c:WaitForChild("HumanoidRootPart", 10)
    c:WaitForChild("Humanoid", 10)
    task.wait(0.5)
    applyKorbloxToTarget(c)
    if headlessEnabled then applyHeadless(c) end
end)

-- Loop visualAll — hanya updateOffset, anti-blink
task.spawn(function()
    while task.wait(3) do
        if visualAllEnabled then
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character then updateOffset(p.Character) end
            end
        end
    end
end)

