        UDim2.new(0.26,0,0,28), UDim2.new(0.38,0,0,yPos),
        THEME.green, 12, false)
    valLbl.Font = Enum.Font.Code

    -- minus button
    local btnMinus = MkBtn(parent, "−",
        UDim2.new(0.13,0,0,26), UDim2.new(0.65,0,0,yPos+1),
        THEME.bg3, 14)
    MkStroke(THEME.violet, 0.8, btnMinus)

    -- plus button
    local btnPlus = MkBtn(parent, "+",
        UDim2.new(0.13,0,0,26), UDim2.new(0.82,0,0,yPos+1),
        THEME.violet, 14)

    btnMinus.MouseButton1Click:Connect(function()
        setter(math.round((getter() - step) * 1000) / 1000)
        valLbl.Text = string.format(fmt, getter())
        if onChanged then onChanged() end
    end)
    btnPlus.MouseButton1Click:Connect(function()
        setter(math.round((getter() + step) * 1000) / 1000)
        valLbl.Text = string.format(fmt, getter())
        if onChanged then onChanged() end
    end)

    return valLbl
end

local function MkToast(guiParent, msg, isErr)
