    scaleXZ      = 1.0,
    scaleY       = 1.0,
    rightEnabled = true,
    leftEnabled  = true,
    headless     = false,
    visualAll    = false,
}
local cfg = {}
local function loadConfig()
    -- isi default dulu, supaya cfg selalu lengkap walau load gagal
    for k, v in pairs(defaultConfig) do cfg[k] = v end
    local ok, data = pcall(function()
        -- support berbagai executor: isfile boleh tidak ada
        local hasFile = pcall(function()
            return type(isfile) == "function" and isfile(CONFIG_FILE)
        end)
        if not hasFile then
            -- fallback: coba readfile langsung, kalau error berarti tidak ada file
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end
        if isfile(CONFIG_FILE) then
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end
        return nil
    end)
    if ok and type(data) == "table" then
        for k, v in pairs(defaultConfig) do
            if data[k] ~= nil then cfg[k] = data[k] end
        end
    end
end
local function saveConfig()
    pcall(function()
        if writefile then
            writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
        end
    end)
end

