-- ================================================
-- HEADLESS
-- ================================================
local function applyHeadless(char)
    if not char then return end
    local head = char:FindFirstChild("Head"); if not head then return end
    head.Transparency = 1
    for _, v in pairs(head:GetChildren()) do
        if v:IsA("Decal") then v.Transparency = 1 end
    end
end
local function removeHeadless(char)
    if not char then return end
    local head = char:FindFirstChild("Head"); if not head then return end
    head.Transparency = 0
    for _, v in pairs(head:GetChildren()) do
        if v:IsA("Decal") then v.Transparency = 0 end
    end
end

-- ================================================
-- REMOVE
-- ================================================
local function removeRight(char)
    if not char then return end
    -- hapus semua kemungkinan nama part kanan (R15 & R6)
    for _, name in pairs({"KorbloxRightLeg", "KorbloxRightLegR6"}) do
        local old = char:FindFirstChild(name); if old then old:Destroy() end
    end
    -- kembalikan transparansi kaki R15
    for _, n in pairs({"RightUpperLeg","RightLowerLeg","RightFoot"}) do
        local p = char:FindFirstChild(n); if p then p.Transparency = 0 end
    end
    -- kembalikan R6
    local rLeg = char:FindFirstChild("Right Leg")
    if rLeg then
        local m = rLeg:FindFirstChild("KorbloxMesh"); if m then m:Destroy() end
        rLeg.Transparency = 0
        rLeg.Color = Color3.fromRGB(163,162,165)
    end
end
local function removeLeft(char)
    if not char then return end
    -- hapus semua kemungkinan nama part kiri (R15 & R6)
    for _, name in pairs({"KorbloxLeftLeg", "KorbloxLeftLegR6"}) do
        local old = char:FindFirstChild(name); if old then old:Destroy() end
    end
    -- kembalikan transparansi kaki R15
    for _, n in pairs({"LeftUpperLeg","LeftLowerLeg","LeftFoot"}) do
        local p = char:FindFirstChild(n); if p then p.Transparency = 0 end
    end
    -- kembalikan R6
    local lLeg = char:FindFirstChild("Left Leg")
    if lLeg then
        local m = lLeg:FindFirstChild("KorbloxMeshLeft"); if m then m:Destroy() end
        lLeg.Transparency = 0
        lLeg.Color = Color3.fromRGB(163,162,165)
    end
end

-- ================================================
-- APPLY
-- ================================================
local function getMeshScale(humanoid)
    local base = 1
    if humanoid and humanoid:FindFirstChild("BodyHeightScale") then
        base = humanoid.BodyHeightScale.Value
    end
    return Vector3.new(scaleXZ * base, scaleY * base, scaleXZ * base)
end
local function applyKorbloxToTarget(char)
    if not char then return end
    local humanoid = char:WaitForChild("Humanoid", 5); if not humanoid then return end
    removeRight(char); removeLeft(char)
    local meshScale = getMeshScale(humanoid)
    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        if rightEnabled then
            local rLeg = char:WaitForChild("RightUpperLeg", 5)
            if rLeg then
                for _, n in pairs({"RightUpperLeg","RightLowerLeg","RightFoot"}) do
                    local p = char:FindFirstChild(n); if p then p.Transparency = 1 end
                end
                local part = Instance.new("Part")
                part.Name="KorbloxRightLeg"; part.CanCollide=false; part.Massless=true
                part.Color=DARK_GREY_COLOR; part.Parent=char
                local mesh = Instance.new("SpecialMesh", part)
                mesh.MeshId=KORBLOX_MESH_ID; mesh.TextureId=KORBLOX_TEXTURE_ID; mesh.Scale=meshScale
                local weld = Instance.new("Weld", part)
                weld.Part0=rLeg; weld.Part1=part; weld.C0=CFrame.new(0,currentOffset,0)
            end
        end
        if leftEnabled then
            local lLeg = char:WaitForChild("LeftUpperLeg", 5)
            if lLeg then
                for _, n in pairs({"LeftUpperLeg","LeftLowerLeg","LeftFoot"}) do
                    local p = char:FindFirstChild(n); if p then p.Transparency = 1 end
                end
                local part = Instance.new("Part")
                part.Name="KorbloxLeftLeg"; part.CanCollide=false; part.Massless=true
                part.Color=DARK_GREY_COLOR; part.Parent=char
                local mesh = Instance.new("SpecialMesh", part)
                mesh.MeshId=LEFT_MESH_ID; mesh.TextureId=KORBLOX_TEXTURE_ID; mesh.Scale=meshScale
                local weld = Instance.new("Weld", part)
                weld.Part0=lLeg; weld.Part1=part; weld.C0=CFrame.new(0,currentOffset,0)
            end
        end
    else
        if rightEnabled then
            local rLeg = char:FindFirstChild("Right Leg")
            if rLeg then
                rLeg.Color = DARK_GREY_COLOR
                local mesh = Instance.new("SpecialMesh"); mesh.Name="KorbloxMesh"
                mesh.MeshId=KORBLOX_MESH_ID; mesh.TextureId=KORBLOX_TEXTURE_ID
                mesh.Scale=meshScale; mesh.Offset=Vector3.new(0,currentOffset,0); mesh.Parent=rLeg
            end
        end
        if leftEnabled then
            local lLeg = char:FindFirstChild("Left Leg")
            if lLeg then
                lLeg.Color = DARK_GREY_COLOR
                local mesh = Instance.new("SpecialMesh"); mesh.Name="KorbloxMeshLeft"
                mesh.MeshId=LEFT_MESH_ID; mesh.TextureId=KORBLOX_TEXTURE_ID
                mesh.Scale=meshScale; mesh.Offset=Vector3.new(0,currentOffset,0); mesh.Parent=lLeg
            end
        end
    end
    if headlessEnabled then applyHeadless(char) end
end
local function applyToEveryone()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then applyKorbloxToTarget(p.Character) end
    end
end
local function updateOffset(char)
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid"); if not humanoid then return end
    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        for _, legName in pairs({"KorbloxRightLeg","KorbloxLeftLeg"}) do
            local leg = char:FindFirstChild(legName)
            if leg then
                local w = leg:FindFirstChildWhichIsA("Weld")
                if w then w.C0 = CFrame.new(0,currentOffset,0) end
            end
        end
    else
        local function upMesh(pName, mName)
            local p = char:FindFirstChild(pName)
            if p then local m = p:FindFirstChild(mName); if m then m.Offset = Vector3.new(0,currentOffset,0) end end
        end
        upMesh("Right Leg","KorbloxMesh"); upMesh("Left Leg","KorbloxMeshLeft")
    end
end
local function updateScale()
    local char = player.Character
    local function setScale(c, legName, r6Name)
        if not c then return end
        local humanoid = c:FindFirstChild("Humanoid")
        local ms = getMeshScale(humanoid)
        local leg = c:FindFirstChild(legName)
        if leg then local mesh = leg:FindFirstChildWhichIsA("SpecialMesh"); if mesh then mesh.Scale = ms end end
        local r6 = c:FindFirstChild(r6Name)
        if r6 then local mesh = r6:FindFirstChildWhichIsA("SpecialMesh"); if mesh then mesh.Scale = ms end end
    end
    setScale(char, "KorbloxRightLeg", "Right Leg")
    setScale(char, "KorbloxLeftLeg",  "Left Leg")
    if visualAllEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            setScale(p.Character, "KorbloxRightLeg", "Right Leg")
            setScale(p.Character, "KorbloxLeftLeg",  "Left Leg")
        end
    end
end

